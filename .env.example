# ============================================================
# WATSS — environment variables (NO secrets in this file)
# Copy to .env.local (dev) or configure in Coolify (production).
# ============================================================

# ------------------------------------------------------------
# Product identity / branding (safe defaults: WATSS)
# ------------------------------------------------------------
APP_NAME=WATSS
NEXT_PUBLIC_APP_NAME=WATSS
# Canonical public URL (scheme + host, no trailing slash). REQUIRED in
# production — invite links and emails fail safely without it.
APP_URL=https://app.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
# Shown on legal pages; replace with the operating company + inbox.
COMPANY_NAME=Your Company LLC
SUPPORT_EMAIL=support@example.com
# Default UI locale for first-time visitors (ar | en).
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Short product mark used in tight UI slots (defaults to WATSS).
NEXT_PUBLIC_APP_SHORT_NAME=WATSS
# Legacy alias consulted by the URL resolver (APP_URL takes priority).
# Kept so older deployments keep working; prefer APP_URL.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# ------------------------------------------------------------
# Supabase (Project Settings → API) — REQUIRED
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key. Bypasses RLS; used only server-side (webhooks,
# automation engine, billing, public API auth). NEVER expose it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# Encryption — REQUIRED
# AES-256-GCM key (64 hex chars) for WhatsApp tokens + AI keys.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it orphans every encrypted secret.
# ------------------------------------------------------------
ENCRYPTION_KEY=your-64-char-hex-key-here

# ------------------------------------------------------------
# Meta / WhatsApp — REQUIRED for messaging
# ------------------------------------------------------------
META_APP_SECRET=your-meta-app-secret
# Needed only for image-header template submission (Resumable Upload).
# META_APP_ID=your-meta-app-id

# ------------------------------------------------------------
# Billing / payments — OPTIONAL until you go live with a provider
# PAYMENT_PROVIDER: empty = disabled (manual billing via admin panel).
# Planned providers: moyasar | myfatoorah. Credentials below belong to
# the chosen provider; the webhook endpoint rejects unsigned events.
# ------------------------------------------------------------
# PAYMENT_PROVIDER=moyasar
# MOYASAR_SECRET_KEY=sk_live_...
# MOYASAR_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------
# Email — OPTIONAL. Supabase Auth covers signup/reset emails. Set an
# SMTP/provider here when product emails (trial ending, payment
# failed) are implemented.
# ------------------------------------------------------------
# EMAIL_PROVIDER=
# EMAIL_FROM=

# ------------------------------------------------------------
# Admin / security — OPTIONAL
# ------------------------------------------------------------
# Cron secrets for scheduled jobs (automation wait steps, usage rollups).
# AUTOMATION_CRON_SECRET=generate-a-long-random-string
# BILLING_CRON_SECRET=generate-a-long-random-string
# Invite URLs resolve via APP_URL / NEXT_PUBLIC_APP_URL (see App section).

# ------------------------------------------------------------
# AI — OPTIONAL tuning (the assistant is BYO-key per workspace)
# ------------------------------------------------------------
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------
# CI / dev only — NEVER set in production
# ------------------------------------------------------------
# WHATSAPP_TEMPLATES_DRY_RUN=true
